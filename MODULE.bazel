module(
    name = "mino",
    version = "0.1.0",
)

bazel_dep(name = "rules_cc", version = "0.2.18")
bazel_dep(name = "googletest", version = "1.15.2")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "spdlog", version = "1.15.3")
bazel_dep(name = "tomlplusplus", version = "3.4.0")

# Production TLS is pinned to BCR's source-built OpenSSL targets. Consumers link
# @openssl//:ssl (and its transitive :crypto), never a host-installed library.
bazel_dep(name = "openssl", version = "3.5.5.bcr.4")

# Benchmark-only comparison dependencies. Production transport and schema code
# do not depend on ZeroMQ, Protobuf, Fast CDR, Fast DDS, or Cyclone DDS.
bazel_dep(name = "libzmq", version = "4.3.5.bcr.5")
bazel_dep(name = "protobuf", version = "29.0-rc3")
bazel_dep(name = "fastcdr", version = "2.3.5.bcr.0")
bazel_dep(name = "fastdds", version = "3.4.2.bcr.1")
bazel_dep(name = "cyclonedds", version = "11.0.1")

# Opt-in hermetic Clang/LLVM toolchain. It is deliberately not registered
# globally: --config=hermetic selects it while host GCC/Apple Clang remain the
# default. LLVM 18.1.8 has official Linux x86_64/aarch64 and Apple arm64
# archives; Intel macOS is pinned to the last official compatible archive.
bazel_dep(name = "toolchains_llvm", version = "1.4.0")

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(
    name = "mino_llvm",
    cxx_standard = {"": "c++20"},
    llvm_versions = {
        "": "18.1.8",
        "darwin-aarch64": "18.1.8",
        "darwin-x86_64": "15.0.7",
    },
)
use_repo(llvm, "mino_llvm", "mino_llvm_llvm")
