# Platform abstraction (shared memory, process identity).
package(default_visibility = ["//visibility:public"])

LINUX_ONLY = select({
    "@platforms//os:linux": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

cc_library(
    name = "process_identity",
    srcs = ["process_identity.cc"],
    hdrs = ["process_identity.h"],
)

cc_library(
    name = "memory_registration",
    srcs = ["memory_registration.cc"],
    hdrs = ["memory_registration.h"],
    deps = [
        "//mino/common:result",
        "//mino/common:status",
    ],
)

cc_library(
    name = "fabric_provider",
    srcs = ["fabric_provider.cc"],
    hdrs = ["fabric_provider.h"],
    deps = [
        "//mino/common:result",
        "//mino/common:status",
        "//mino/transport:transport_driver",
    ],
)

cc_test(
    name = "fabric_provider_test",
    srcs = ["fabric_provider_test.cc"],
    deps = [
        ":fabric_provider",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "rdma_provider",
    srcs = ["rdma_provider.cc"],
    hdrs = ["rdma_provider.h"],
    deps = [
        ":memory_registration",
        "//mino/common:result",
        "//mino/common:status",
        "//mino/security:tls",
        "//mino/transport:transport_driver",
    ],
)

cc_test(
    name = "memory_registration_test",
    srcs = ["memory_registration_test.cc"],
    deps = [
        ":memory_registration",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "rdma_provider_test",
    srcs = ["rdma_provider_test.cc"],
    deps = [
        ":rdma_provider",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "numa",
    srcs = ["numa.cc"],
    hdrs = ["numa.h"],
    deps = [
        "//mino/common:result",
        "//mino/common:status",
    ],
)

cc_test(
    name = "numa_test",
    srcs = ["numa_test.cc"],
    deps = [
        ":numa",
        "//mino/common:status",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "shared_memory",
    srcs = ["shared_memory.cc"],
    hdrs = [
        "shared_memory.h",
        "shared_memory_marker.h",
    ],
    deps = [
        ":process_identity",
        "//mino/common:result",
        "//mino/common:status",
    ],
)

cc_test(
    name = "shared_memory_test",
    srcs = ["shared_memory_test.cc"],
    target_compatible_with = LINUX_ONLY,
    deps = [
        ":shared_memory",
        "//mino/common:status",
        "@googletest//:gtest_main",
    ],
)

cc_binary(
    name = "shared_memory_fault_helper",
    testonly = True,
    srcs = ["shared_memory_fault_helper.cc"],
    deps = [":shared_memory"],
)

cc_test(
    name = "shared_memory_concurrency_test",
    srcs = ["shared_memory_concurrency_test.cc"],
    data = [":shared_memory_fault_helper"],
    target_compatible_with = LINUX_ONLY,
    deps = [
        ":shared_memory",
        "//mino/common:status",
        "@googletest//:gtest_main",
    ],
)

# Requires Linux, a hugetlbfs mount, and at least two reserved huge pages. It is
# intentionally excluded from wildcard CI; huge-page-validation.yml runs it on
# a prepared self-hosted runner.
cc_test(
    name = "shared_memory_huge_page_test",
    srcs = ["shared_memory_huge_page_test.cc"],
    tags = [
        "manual",
        "requires-hugepages",
    ],
    target_compatible_with = LINUX_ONLY,
    deps = [
        ":shared_memory",
        "//mino/common:ids",
        "//mino/common:status",
        "//mino/shm/allocator:central_slab",
        "//mino/shm/region",
        "//mino/shm/region:handle_resolver",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "process_identity_test",
    srcs = ["process_identity_test.cc"],
    deps = [
        ":process_identity",
        "@googletest//:gtest_main",
    ],
)


# ---------------------------------------------------------------------------
# Reference device plugins (shared libraries). Load via absolute dlopen path:
#   CreateDynamicRdmaDeviceProvider({.plugin_path = "<abs>/libmino_rdma_software_loopback.so", ...})
#   CreateDynamicFabricDeviceProvider({.plugin_path = "<abs>/libmino_fabric_software_loopback.so", ...})
# Software loopbacks report kDevice for ABI acceptance but are NOT V-25
# qualification-eligible (see provenance + docs/*-driver.md).
# ---------------------------------------------------------------------------

cc_binary(
    name = "libmino_rdma_software_loopback.so",
    srcs = ["plugins/rdma_software_loopback_plugin.cc"],
    linkshared = True,
    linkstatic = True,
    deps = [
        ":rdma_provider",
    ],
)

cc_binary(
    name = "libmino_rdma_verbs.so",
    srcs = ["plugins/rdma_verbs_plugin.cc"],
    linkshared = True,
    linkstatic = True,
    deps = [
        ":rdma_provider",
    ],
)

cc_binary(
    name = "libmino_fabric_software_loopback.so",
    srcs = ["plugins/fabric_software_loopback_plugin.cc"],
    linkshared = True,
    linkstatic = True,
    deps = [
        ":fabric_provider",
    ],
)

cc_test(
    name = "rdma_plugin_load_test",
    srcs = ["rdma_plugin_load_test.cc"],
    data = [
        ":libmino_rdma_software_loopback.so",
        ":libmino_rdma_verbs.so",
    ],
    deps = [
        ":memory_registration",
        ":rdma_provider",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "fabric_plugin_load_test",
    srcs = ["fabric_plugin_load_test.cc"],
    data = [":libmino_fabric_software_loopback.so"],
    deps = [
        ":fabric_provider",
        "@googletest//:gtest_main",
    ],
)
