# Bridge canonical wire frame codec. Socket/TCP drivers are intentionally not
# part of this package target.
package(default_visibility = ["//visibility:public"])

cc_library(
    name = "crc32c",
    srcs = ["crc32c.cc"],
    hdrs = ["crc32c.h"],
)

cc_library(
    name = "wire_frame",
    srcs = ["wire_frame.cc"],
    hdrs = ["wire_frame.h"],
    deps = [
        ":crc32c",
        "//mino/common:result",
        "//mino/common:status",
    ],
)

cc_library(
    name = "reliability",
    srcs = [
        "control_payload.cc",
        "dedup_window.cc",
        "retransmit_window.cc",
    ],
    hdrs = [
        "control_payload.h",
        "dedup_window.h",
        "retransmit_window.h",
        "source_identity.h",
    ],
    deps = [
        "//mino/common:ids",
        "//mino/common:result",
        "//mino/common:status",
        "//mino/platform:process_identity",
    ],
)

cc_library(
    name = "schema_negotiator",
    srcs = ["schema_negotiator.cc"],
    hdrs = ["schema_negotiator.h"],
    deps = [
        ":wire_frame",
        "//mino/common:result",
        "//mino/schema:canonical",
        "//mino/schema:descriptor",
        "//mino/schema:registry",
    ],
)

cc_library(
    name = "bridge_pipeline",
    srcs = ["bridge_pipeline.cc"],
    hdrs = ["bridge_pipeline.h"],
    deps = [
        ":reliability",
        ":schema_negotiator",
        ":wire_frame",
        "//mino/common:result",
        "//mino/registry",
        "//mino/transport:transport_driver",
    ],
)

cc_library(
    name = "bridge_connection_manager",
    srcs = [
        "bridge_runtime/connection_manager.cc",
        "bridge_runtime/connection_pool.cc",
    ],
    hdrs = [
        "bridge_runtime/connection_manager.h",
        "bridge_runtime/connection_pool.h",
    ],
    deps = [
        ":bridge_pipeline",
        "//mino/common:result",
        "//mino/observability",
        "//mino/runtime:bus",
        "//mino/schema:canonical",
        "//mino/transport:transport_driver",
    ],
)

cc_library(
    name = "remote_object_reconstructor",
    srcs = ["remote_object_reconstructor.cc"],
    hdrs = ["remote_object_reconstructor.h"],
    deps = [
        ":bridge_pipeline",
        ":schema_negotiator",
        "//mino/common:ids",
        "//mino/common:result",
        "//mino/platform:process_identity",
        "//mino/registry",
        "//mino/runtime:allocation_journal",
        "//mino/schema:dynamic_object",
        "//mino/schema:layout",
        "//mino/schema:registry",
        "//mino/schema:wire",
        "//mino/shm/allocator:central_slab",
        "//mino/shm/channel:index_slot",
        "//mino/shm/channel:spsc",
    ],
)

