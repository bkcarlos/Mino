# D2-13: fork + MAP_SHARED SIGKILL/SIGSTOP/PID-reuse recovery stress.
# The default target runs a short randomized smoke and is included in //...
# MINO_D2_RECOVERY_STRESS_SECONDS controls the randomized phase duration;
# MINO_D2_RECOVERY_STRESS_SEED makes a failing sequence reproducible.
cc_test(
    name = "d2_recovery_stress_test",
    srcs = ["d2_recovery_stress_test.cc"],
    deps = [
        ":allocation_journal",
        ":publisher",
        ":subscriber",
        ":subscriber_lease",
        "//mino/common:status",
        "//mino/platform:process_identity",
        "//mino/shm/allocator:central_slab",
        "//mino/shm/channel:broadcast",
        "//mino/shm/channel:index_slot",
        "//mino/shm/channel:mpsc",
        "//mino/shm/channel:queue_full_policy",
        "@googletest//:gtest_main",
    ],
)

# Explicit 3600-second variant, excluded from wildcard CI. Bazel timeout
# classes do not encode arbitrary seconds, so the finite 3660-second outer
# watchdog is supplied explicitly when invoking this manual target:
#   bazel test //mino/runtime:d2_recovery_stress_long_test \
#     --test_timeout=3660 \
#     --test_output=streamed \
#     --test_env=MINO_D2_RECOVERY_STRESS_SEED=12345
cc_test(
    name = "d2_recovery_stress_long_test",
    timeout = "long",
    srcs = ["d2_recovery_stress_test.cc"],
    args = [
        "--gtest_filter=D2RecoveryStressTest.RandomizedTimedRecoveryStress:" +
        "D2RecoveryStressTest.RequiresPosixSharedMemoryAndProcessSignals",
    ],
    env = {"MINO_D2_RECOVERY_STRESS_SECONDS": "3600"},
    tags = [
        "large",
        "manual",
    ],
    deps = [
        ":allocation_journal",
        ":publisher",
        ":subscriber",
        ":subscriber_lease",
        "//mino/common:status",
        "//mino/platform:process_identity",
        "//mino/shm/allocator:central_slab",
        "//mino/shm/channel:broadcast",
        "//mino/shm/channel:index_slot",
        "//mino/shm/channel:mpsc",
        "//mino/shm/channel:queue_full_policy",
        "@googletest//:gtest_main",
    ],
)

