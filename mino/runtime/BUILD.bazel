# Runtime fork + MAP_SHARED publisher/subscriber SIGKILL, slow-subscriber,
# lease-boundary, SIGSTOP, and PID-incarnation recovery stress.
# The default target runs a short randomized smoke and is included in //...
# MINO_RUNTIME_RECOVERY_STRESS_SECONDS controls the randomized phase duration;
# MINO_RUNTIME_RECOVERY_STRESS_SEED makes a failing sequence reproducible.
cc_test(
    name = "runtime_recovery_stress_test",
    srcs = ["runtime_recovery_stress_test.cc"],
    deps = [
        ":allocation_journal",
        ":journal_channel_recovery",
        ":publisher",
        ":subscriber",
        ":subscriber_lease",
        "//mino/common:status",
        "//mino/platform:process_identity",
        "//mino/shm/allocator:central_slab",
        "//mino/shm/channel:broadcast",
        "//mino/shm/channel:index_slot",
        "//mino/shm/channel:mpsc",
        "//mino/shm/channel:queue_full_policy",
        "@googletest//:gtest_main",
    ],
)

# Explicit 3600-second variant, excluded from wildcard CI. Bazel timeout
# classes do not encode arbitrary seconds, so the finite 3900-second outer
# watchdog includes deterministic cutpoint/lease checks after the timed phase:
#   bazel test //mino/runtime:runtime_recovery_stress_long_test \
#     --test_timeout=3900 \
#     --test_output=streamed \
#     --test_env=MINO_RUNTIME_RECOVERY_STRESS_SEED=12345
cc_test(
    name = "runtime_recovery_stress_long_test",
    timeout = "long",
    srcs = ["runtime_recovery_stress_test.cc"],
    args = [
        "--gtest_filter=RuntimeRecoveryStressTest.RandomizedTimedRecoveryStress:" +
        "RuntimeRecoveryStressTest.SigkillAtEveryPersistentStoreRecovers:" +
        "RuntimeRecoveryStressTest.SigstopLiveOwnerIsNeverRecovered:" +
        "RuntimeRecoveryStressTest.ForeignLivePidIncarnationMismatchIsUnknown:" +
        "RuntimeRecoveryStressTest.DeadBroadcastSubscriberLeaseClearsRealAcks:" +
        "RuntimeRecoveryStressTest.SlowSubscriberBackpressurePreservesConservation:" +
        "RuntimeRecoveryStressTest.DeadSubscriberLeaseBoundaryIsExact:" +
        "RuntimeRecoveryStressTest.RequiresPosixSharedMemoryAndProcessSignals",
    ],
    env = {"MINO_RUNTIME_RECOVERY_STRESS_SECONDS": "3600"},
    tags = [
        "large",
        "manual",
    ],
    deps = [
        ":allocation_journal",
        ":journal_channel_recovery",
        ":publisher",
        ":subscriber",
        ":subscriber_lease",
        "//mino/common:status",
        "//mino/platform:process_identity",
        "//mino/shm/allocator:central_slab",
        "//mino/shm/channel:broadcast",
        "//mino/shm/channel:index_slot",
        "//mino/shm/channel:mpsc",
        "//mino/shm/channel:queue_full_policy",
        "@googletest//:gtest_main",
    ],
)

