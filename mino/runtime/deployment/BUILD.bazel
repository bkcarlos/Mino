package(default_visibility = ["//visibility:public"])

cc_library(
    name = "monitoring",
    srcs = ["monitoring.cc"],
    hdrs = ["monitoring.h"],
    linkopts = select({
        "@platforms//os:linux": ["-pthread"],
        "//conditions:default": [],
    }),
    deps = [
        ":local_bus",
        ":remote_bridge",
        "//mino/capacity",
        "//mino/common:result",
        "//mino/common:status",
        "//mino/observability",
        "//mino/security:tls",
        "//mino/shm/allocator:central_slab",
        "//mino/shm/allocator:large_object_pool",
        "//mino/storage:recorder",
    ],
)

cc_test(
    name = "monitoring_test",
    srcs = ["monitoring_test.cc"],
    deps = [
        ":monitoring",
        "//mino/schema:compiler",
        "//mino/schema:layout",
        "//mino/schema/codegen:artifact_codec",
        "//mino/security:test_tls_credentials",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "remote_bridge",
    srcs = ["remote_bridge.cc"],
    hdrs = ["remote_bridge.h"],
    deps = [
        "//mino/bridge:bridge_connection_manager",
        "//mino/bridge:schema_negotiator",
        "//mino/capacity",
        "//mino/common:result",
        "//mino/common:status",
        "//mino/registry",
        "//mino/schema:registry",
        "//mino/security:tls",
        "//mino/storage:schema_store",
        "//mino/transport:fabric_driver",
        "//mino/transport:rdma_driver",
        "//mino/transport:tcp_driver",
    ],
)

cc_library(
    name = "remote_bridge_test_helper",
    testonly = True,
    srcs = ["remote_bridge_test_helper.cc"],
    hdrs = ["remote_bridge_test_helper.h"],
    deps = [":remote_bridge"],
)

cc_test(
    name = "remote_bridge_test",
    srcs = ["remote_bridge_test.cc"],
    deps = [
        ":remote_bridge",
        ":remote_bridge_test_helper",
        "//mino/capacity",
        "//mino/common:status",
        "//mino/schema:compiler",
        "//mino/schema:layout",
        "//mino/schema/codegen:artifact_codec",
        "//mino/storage:schema_store",
        "@googletest//:gtest_main",
    ],
)

