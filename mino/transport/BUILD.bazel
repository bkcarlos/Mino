# Transport driver abstraction and endpoint persistence codec.
package(default_visibility = ["//visibility:public"])

cc_library(
    name = "transport_driver",
    srcs = ["transport_driver.cc"],
    hdrs = ["transport_driver.h"],
    deps = [
        "//mino/common:result",
        "//mino/common:status",
        "//mino/runtime:delivery_receipt",
    ],
)

cc_library(
    name = "tcp_driver",
    srcs = ["tcp_driver.cc"],
    hdrs = ["tcp_driver.h"],
    deps = [
        ":transport_driver",
        "//mino/bridge:wire_frame",
        "//mino/common:result",
        "//mino/common:status",
    ],
)

cc_library(
    name = "udp_driver",
    srcs = ["udp_driver.cc"],
    hdrs = ["udp_driver.h"],
    deps = [
        ":transport_driver",
        "//mino/common:result",
        "//mino/common:status",
    ],
)

cc_library(
    name = "transport_switcher",
    srcs = ["transport_switcher.cc"],
    hdrs = ["transport_switcher.h"],
    deps = [
        ":transport_driver",
        "//mino/common:result",
        "//mino/registry:registry",
        "//mino/schema:descriptor",
    ],
)

cc_test(
    name = "tcp_driver_test",
    srcs = ["tcp_driver_test.cc"],
    deps = [
        ":tcp_driver",
        "//mino/bridge:wire_frame",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "udp_driver_test",
    srcs = ["udp_driver_test.cc"],
    deps = [
        ":udp_driver",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "transport_switcher_test",
    srcs = ["transport_switcher_test.cc"],
    deps = [
        ":transport_switcher",
        "//mino/registry:registry",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "transport_driver_test",
    srcs = ["transport_driver_test.cc"],
    deps = [
        ":transport_driver",
        "//mino/common:status",
        "@googletest//:gtest_main",
    ],
)
