# Transport driver abstraction and endpoint persistence codec.
package(default_visibility = ["//visibility:public"])

cc_library(
    name = "transport_driver",
    srcs = ["transport_driver.cc"],
    hdrs = ["transport_driver.h"],
    deps = [
        "//mino/common:result",
        "//mino/common:status",
        "//mino/runtime:delivery_receipt",
        "//mino/security:tls",
    ],
)

cc_library(
    name = "tcp_driver",
    srcs = ["tcp_driver.cc"],
    hdrs = ["tcp_driver.h"],
    deps = [
        ":transport_driver",
        "//mino/bridge:wire_frame",
        "//mino/common:result",
        "//mino/common:status",
        "//mino/security:tls",
    ],
)

cc_library(
    name = "udp_driver",
    srcs = ["udp_driver.cc"],
    hdrs = ["udp_driver.h"],
    deps = [
        ":transport_driver",
        "//mino/common:result",
        "//mino/common:status",
    ],
)

cc_library(
    name = "fabric_driver",
    srcs = ["fabric_driver.cc"],
    hdrs = ["fabric_driver.h"],
    deps = [
        ":transport_driver",
        "//mino/bridge:wire_frame",
        "//mino/common:result",
        "//mino/common:status",
        "//mino/platform:fabric_provider",
        "//mino/security:tls",
    ],
)

cc_library(
    name = "rdma_driver",
    srcs = ["rdma_driver.cc"],
    hdrs = ["rdma_driver.h"],
    deps = [
        ":transport_driver",
        "//mino/common:result",
        "//mino/common:status",
        "//mino/platform:memory_registration",
        "//mino/platform:rdma_provider",
        "//mino/security:tls",
    ],
)

cc_library(
    name = "transport_switcher",
    srcs = ["transport_switcher.cc"],
    hdrs = ["transport_switcher.h"],
    deps = [
        ":transport_driver",
        "//mino/common:result",
        "//mino/registry",
        "//mino/schema:descriptor",
    ],
)

cc_test(
    name = "tcp_driver_test",
    srcs = ["tcp_driver_test.cc"],
    deps = [
        ":tcp_driver",
        "//mino/bridge:wire_frame",
        "//mino/security:test_tls_credentials",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "udp_driver_test",
    srcs = ["udp_driver_test.cc"],
    deps = [
        ":udp_driver",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "fabric_driver_test",
    srcs = ["fabric_driver_test.cc"],
    deps = [
        ":fabric_driver",
        "//mino/bridge:wire_frame",
        "//mino/platform:fabric_provider",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "rdma_driver_test",
    srcs = ["rdma_driver_test.cc"],
    deps = [
        ":rdma_driver",
        "//mino/platform:rdma_provider",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "transport_switcher_test",
    srcs = ["transport_switcher_test.cc"],
    deps = [
        ":transport_switcher",
        "//mino/registry",
        "@googletest//:gtest_main",
    ],
