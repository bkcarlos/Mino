# IDL compiler core and dynamic schema runtime primitives.
package(default_visibility = ["//visibility:public"])

cc_library(
    name = "ast",
    hdrs = ["ast.h"],
)

cc_library(
    name = "lexer",
    srcs = ["lexer.cc"],
    hdrs = ["lexer.h"],
    deps = [
        ":ast",
        "//mino/common:result",
        "//mino/common:status",
    ],
)

