# Channel models (SPSC, MPSC, broadcast, work queue).
#
# mpmc_ring is the generic MPMC skeleton (design doc 9.9): the bounded
# Vyukov ring shared by every cross-process channel implementation. It is
# header-only because the element type is a template parameter.
package(default_visibility = ["//visibility:public"])

cc_library(
    name = "ring_directory_abi",
    hdrs = ["ring_directory_abi.h"],
)

cc_library(
    name = "mpmc_ring",
    hdrs = ["mpmc_ring.h"],
    deps = [
        "//mino/common:result",
        "//mino/common:status",
    ],
)

# D2-01: IndexSlot ABI (design doc 9.2, ADR-0003). The fixed 128-byte
# control-plane record carried by every channel ring slot, plus the
# channel-specific sidecar metadata types (broadcast / work queue / MPSC
# reservation) and the immutable-metadata CRC.
cc_library(
    name = "index_slot",
    srcs = ["index_slot.cc"],
    hdrs = ["index_slot.h"],
    deps = [
        "//mino/abi:shm_abi",
    ],
)

cc_test(
    name = "index_slot_test",
    srcs = ["index_slot_test.cc"],
    deps = [
        ":index_slot",
        "@googletest//:gtest_main",
    ],
)

# D2-07: QueueFullPolicy (design doc 9.8). The policy applied when a
# producer publishes into a full channel; shared by SPSC / MPSC /
# broadcast / work queue.
cc_library(
    name = "queue_full_policy",
    hdrs = ["queue_full_policy.h"],
)

# D2-03/D2-04: MPSC channel (design doc 9.5). Multi-producer / single-
# consumer strictly-ordered ring with Vyukov probe-then-claim reservation,
# an ordered commit bitmap (INV-17), owner-identity sidecars, and crash
# recovery via AbortOrphanedReservations(). Header-only: a non-owning view
# over shared memory.
cc_library(
    name = "mpsc",
    hdrs = ["mpsc_channel.h"],
    deps = [
        ":index_slot",
        ":queue_full_policy",
        ":spsc",
        "//mino/common:result",
        "//mino/common:status",
        "//mino/platform:process_identity",
    ],
)

cc_test(
    name = "mpsc_channel_test",
    timeout = "long",
    srcs = ["mpsc_channel_test.cc"],
    deps = [
        ":index_slot",
        ":mpsc",
        ":queue_full_policy",
        "//mino/common:result",
        "//mino/common:status",
        "//mino/platform:process_identity",
        "@googletest//:gtest_main",
    ],
)

# V-03 (cross-process): fork + MAP_SHARED MPSC tests. Conservation (2P x 1C,
# ~62 wrap cycles, ordered prefix INV-17) and producer-crash recovery (orphan
# reservation reclaimed via /proc liveness + lease, Linux-only). Fast, part
# of the default `bazel test //...` run.
cc_test(
    name = "mpsc_channel_xproc_test",
    srcs = ["mpsc_channel_xproc_test.cc"],
    deps = [
        ":index_slot",
        ":mpsc",
        "//mino/common:result",
        "//mino/common:status",
        "//mino/platform:process_identity",
        "@googletest//:gtest_main",
    ],
)

# D2-02: SPSC channel (design doc 9.3, 9.4). Single-producer /
# single-consumer channel with cache-line-separated cursors, built on the
# IndexSlot ABI. Header-only: it is a non-owning view over shared memory.
cc_library(
    name = "spsc",
    hdrs = ["spsc_channel.h"],
    deps = [
        ":index_slot",
        ":queue_full_policy",
        "//mino/common:result",
        "//mino/common:status",
    ],
)

cc_test(
    name = "spsc_channel_test",
    srcs = ["spsc_channel_test.cc"],
    deps = [
        ":index_slot",
        ":queue_full_policy",
        ":spsc",
        "//mino/common:result",
        "//mino/common:status",
        "@googletest//:gtest_main",
    ],
)

# INV-01 (cross-process): fork + MAP_SHARED long-wrap test. Fast (a few
# seconds), part of the default `bazel test //...` run, same style as
# mpmc_ring_xproc_test (V-26).
cc_test(
    name = "spsc_channel_xproc_test",
    srcs = ["spsc_channel_xproc_test.cc"],
    deps = [
        ":index_slot",
        ":queue_full_policy",
        ":spsc",
        "//mino/common:result",
        "//mino/common:status",
        "@googletest//:gtest_main",
    ],
)

# D2-05: Broadcast channel (design doc 9.6). Single-publisher / N-subscriber
# fan-out with per-subscriber cursors, per-slot AckBitmap sidecars bound to a
# seqlock-style subscriber-set snapshot, and cache-line-separated subscriber
# slots. Header-only: a non-owning view over shared memory.
cc_library(
    name = "broadcast",
    hdrs = ["broadcast_channel.h"],
    deps = [
        ":index_slot",
        ":queue_full_policy",
        ":spsc",
        "//mino/common:ids",
        "//mino/common:result",
        "//mino/common:status",
        "//mino/platform:process_identity",
    ],
)

cc_test(
    name = "broadcast_channel_test",
    srcs = ["broadcast_channel_test.cc"],
    deps = [
        ":broadcast",
        ":index_slot",
        ":queue_full_policy",
        "//mino/common:ids",
        "//mino/common:result",
        "//mino/common:status",
        "@googletest//:gtest_main",
    ],
)

# D2-05 (cross-process): fork + MAP_SHARED broadcast tests. Fan-out
# conservation (1 publisher process x 3 subscriber processes over many wrap
# cycles) and publisher-crash tombstone skipping across a process boundary.
cc_test(
    name = "broadcast_channel_xproc_test",
    srcs = ["broadcast_channel_xproc_test.cc"],
    deps = [
        ":broadcast",
        ":index_slot",
        ":queue_full_policy",
        "//mino/common:result",
        "//mino/common:status",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "mpmc_ring_test",
    srcs = ["mpmc_ring_test.cc"],
    deps = [
        ":mpmc_ring",
        "//mino/common:result",
        "//mino/common:status",
        "@googletest//:gtest_main",
    ],
)

# V-26: cross-process MPMC ring tests (fork + MAP_SHARED): conservation,
# wraparound and full/empty probing across process boundaries. Fast (a few
# seconds), so it is part of the default `bazel test //...` run.
cc_test(
    name = "mpmc_ring_xproc_test",
    srcs = ["mpmc_ring_xproc_test.cc"],
    deps = [
        ":mpmc_ring",
        "//mino/common:result",
        "//mino/common:status",
        "@googletest//:gtest_main",
    ],
)

# Long-running stress test: excluded from the default CI run. Execute
# explicitly (ideally under --config=tsan) with e.g.
#   bazel test //mino/shm/channel:mpmc_ring_stress_test \
#       --test_timeout=3600 --test_env=MPMC_STRESS_DURATION_SEC=60
cc_test(
    name = "mpmc_ring_stress_test",
    srcs = ["mpmc_ring_stress_test.cc"],
    # manual: skipped by wildcard builds/tests (bazel test //...), must be
    # requested explicitly. large: tells Bazel to allow a long runtime when
    # it is requested.
    tags = [
        "large",
        "manual",
    ],
    deps = [
        ":mpmc_ring",
        "//mino/common:result",
        "//mino/common:status",
        "@googletest//:gtest_main",
    ],
)
