# Central Slab Allocator (design doc section 8).
package(default_visibility = ["//visibility:public"])

cc_library(
    name = "slab_header",
    hdrs = ["slab_header.h"],
)

cc_library(
    name = "class_table",
    srcs = ["class_table.cc"],
    hdrs = ["class_table.h"],
    deps = [
        "//mino/common:result",
        "//mino/common:status",
    ],
)

cc_library(
    name = "bitmap",
    srcs = ["bitmap.cc"],
    hdrs = ["bitmap.h"],
    deps = [
        "//mino/common:result",
        "//mino/common:status",
    ],
)

cc_library(
    name = "generation_array",
    srcs = ["generation_array.cc"],
    hdrs = ["generation_array.h"],
    deps = [
        "//mino/common:result",
        "//mino/common:status",
    ],
)

cc_library(
    name = "central_slab",
    srcs = ["central_slab.cc"],
    hdrs = ["central_slab.h"],
    deps = [
        ":bitmap",
        ":class_table",
        ":generation_array",
        ":slab_header",
        "//mino/abi:shm_abi",
        "//mino/common:result",
        "//mino/common:status",
    ],
)

cc_library(
    name = "large_object_pool",
    srcs = ["large_object_pool.cc"],
    hdrs = ["large_object_pool.h"],
    deps = [
        ":generation_array",
        ":slab_header",
        "//mino/abi:shm_abi",
        "//mino/common:result",
        "//mino/common:status",
    ],
)

