# Shared memory Region lifecycle: SuperBlock, Region, Recovery, HandleResolver.
package(default_visibility = ["//visibility:public"])

cc_library(
    name = "superblock",
    hdrs = ["superblock.h"],
    deps = [
        "//mino/common:checked_arithmetic",
        "//mino/platform:process_identity",
    ],
)

# The Region lifecycle and the Recovery Owner protocol are compiled into a
# single library because they are mutually dependent at the source level:
# region.cc drives recovery on Attach, while recovery.cc reads the Region's
# SuperBlock. Keeping them together avoids a Bazel target cycle.
cc_library(
    name = "region",
    srcs = [
        "recovery.cc",
        "region.cc",
    ],
    hdrs = [
        "recovery.h",
        "region.h",
    ],
    deps = [
        ":superblock",
        "//mino/common:checked_arithmetic",
        "//mino/common:result",
        "//mino/common:status",
        "//mino/platform:process_identity",
        "//mino/platform:shared_memory",
        "//mino/shm/allocator:central_slab",
        "//mino/shm/recovery:scanner",
    ],
)

cc_library(
    name = "handle_resolver",
    srcs = ["handle_resolver.cc"],
    hdrs = ["handle_resolver.h"],
    deps = [
        ":region",
        ":superblock",
        "//mino/abi:shm_abi",
        "//mino/common:checked_arithmetic",
        "//mino/common:ids",
        "//mino/common:result",
        "//mino/common:status",
        "//mino/platform:process_identity",
        "//mino/shm/allocator:slab_header",
    ],
)

cc_test(
    name = "region_test",
    srcs = ["region_test.cc"],
    deps = [
        ":region",
        ":superblock",
        "//mino/common:status",
        "//mino/platform:shared_memory",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "recovery_test",
    srcs = ["recovery_test.cc"],
    deps = [
        ":region",
        ":superblock",
        "//mino/common:status",
        "//mino/platform:process_identity",
        "//mino/platform:shared_memory",
        "//mino/shm/allocator:central_slab",
        "//mino/shm/allocator:slab_header",
        "@googletest//:gtest_main",
    ],
)

# D1 Region/Allocator/RecoveryScanner fork + MAP_SHARED kill stress.
# The default target is a short smoke. Reproduce failures with:
#   --test_env=MINO_D1_REGION_RECOVERY_STRESS_SEED=<seed>
# and adjust duration with MINO_D1_REGION_RECOVERY_STRESS_SECONDS.
cc_test(
    name = "d1_region_recovery_kill_stress_test",
    srcs = ["d1_region_recovery_kill_stress_test.cc"],
    deps = [
        ":region",
        ":superblock",
        "//mino/common:status",
        "//mino/platform:process_identity",
        "//mino/platform:shared_memory",
        "//mino/shm/allocator:central_slab",
        "//mino/shm/allocator:slab_header",
        "//mino/shm/recovery:scanner",
        "@googletest//:gtest_main",
    ],
)

# Explicit one-hour randomized variant, excluded from wildcard CI. Invoke with
# a finite outer watchdog, for example:
#   bazel test //mino/shm/region:d1_region_recovery_kill_stress_long_test \
#     --test_timeout=3660 --test_output=streamed \
#     --test_env=MINO_D1_REGION_RECOVERY_STRESS_SEED=12345
cc_test(
    name = "d1_region_recovery_kill_stress_long_test",
    timeout = "long",
    srcs = ["d1_region_recovery_kill_stress_test.cc"],
    args = [
        "--gtest_filter=D1RegionRecoveryKillStressTest.RandomizedTimedRecoveryStress:" +
        "D1RegionRecoveryKillStressTest.RequiresPosixSharedMemoryAndProcessSignals",
    ],
    env = {"MINO_D1_REGION_RECOVERY_STRESS_SECONDS": "3600"},
    tags = [
        "large",
        "manual",
    ],
    deps = [
        ":region",
        ":superblock",
        "//mino/common:status",
        "//mino/platform:process_identity",
        "//mino/platform:shared_memory",
        "//mino/shm/allocator:central_slab",
        "//mino/shm/allocator:slab_header",
        "//mino/shm/recovery:scanner",
        "@googletest//:gtest_main",
    ],
)

