# The Region lifecycle and the Recovery Owner protocol are compiled into a
# single library because they are mutually dependent at the source level:
# region.cc drives recovery on Attach, while recovery.cc reads the Region's
# SuperBlock. Keeping them together avoids a Bazel target cycle.
cc_library(
    name = "region",
    srcs = [
        "recovery.cc",
        "region.cc",
    ],
    hdrs = [
        "recovery.h",
        "region.h",
    ],
    deps = [
        ":channel_directory",
        ":recovery_directory",
        ":region_id_allocator",
        ":superblock",
        "//mino/common:checked_arithmetic",
        "//mino/common:result",
        "//mino/common:status",
        "//mino/platform:process_identity",
        "//mino/platform:shared_memory",
        "//mino/shm/allocator:central_slab",
        "//mino/shm/allocator:large_object_pool",
        "//mino/shm/channel:mpmc_ring",
        "//mino/shm/recovery:scanner",
    ],
)

cc_library(
    name = "handle_resolver",
    srcs = ["handle_resolver.cc"],
    hdrs = ["handle_resolver.h"],
    deps = [
        ":region",
        ":superblock",
        "//mino/abi:shm_abi",
        "//mino/common:checked_arithmetic",
        "//mino/common:ids",
        "//mino/common:result",
        "//mino/common:status",
        "//mino/platform:process_identity",
        "//mino/shm/allocator:central_slab",
        "//mino/shm/allocator:large_object_pool",
        "//mino/shm/allocator:slab_header",
    ],
)

cc_test(
    name = "region_test",
    srcs = ["region_test.cc"],
    target_compatible_with = LINUX_ONLY,
    deps = [
        ":region",
        ":superblock",
        "//mino/common:status",
        "//mino/platform:shared_memory",
        "//mino/shm/channel:broadcast",
        "//mino/shm/channel:index_slot",
        "//mino/shm/channel:mpmc_ring",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "recovery_test",
    srcs = ["recovery_test.cc"],
    target_compatible_with = LINUX_ONLY,
    deps = [
        ":region",
        ":superblock",
        "//mino/common:status",
        "//mino/platform:process_identity",
        "//mino/platform:shared_memory",
        "//mino/shm/allocator:central_slab",
        "//mino/shm/allocator:large_object_pool",
        "//mino/shm/allocator:slab_header",
        "@googletest//:gtest_main",
