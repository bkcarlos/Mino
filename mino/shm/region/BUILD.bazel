# Region/Allocator/RecoveryScanner fork + MAP_SHARED kill stress.
# The default target is a short smoke. Reproduce failures with:
#   --test_env=MINO_REGION_RECOVERY_STRESS_SEED=<seed>
# and adjust duration with MINO_REGION_RECOVERY_STRESS_SECONDS.
cc_test(
    name = "region_recovery_kill_stress_test",
    srcs = ["region_recovery_kill_stress_test.cc"],
    target_compatible_with = LINUX_ONLY,
    deps = [
        ":region",
        ":superblock",
        "//mino/common:status",
        "//mino/platform:process_identity",
        "//mino/platform:shared_memory",
        "//mino/shm/allocator:central_slab",
        "//mino/shm/allocator:slab_header",
        "//mino/shm/recovery:scanner",
        "@googletest//:gtest_main",
    ],
)

# Explicit one-hour randomized variant, excluded from wildcard CI. Invoke with
# a finite outer watchdog, for example:
#   bazel test //mino/shm/region:region_recovery_kill_stress_long_test \
#     --test_timeout=3660 --test_output=streamed \
#     --test_env=MINO_REGION_RECOVERY_STRESS_SEED=12345
cc_test(
    name = "region_recovery_kill_stress_long_test",
    timeout = "long",
    srcs = ["region_recovery_kill_stress_test.cc"],
    args = [
        "--gtest_filter=RegionRecoveryKillStressTest.RandomizedTimedRecoveryStress:" +
        "RegionRecoveryKillStressTest.RequiresPosixSharedMemoryAndProcessSignals",
    ],
    env = {"MINO_REGION_RECOVERY_STRESS_SECONDS": "3600"},
    tags = [
        "large",
        "manual",
    ],
    target_compatible_with = LINUX_ONLY,
    deps = [
        ":region",
        ":superblock",
        "//mino/common:status",
        "//mino/platform:process_identity",
        "//mino/platform:shared_memory",
        "//mino/shm/allocator:central_slab",
        "//mino/shm/allocator:slab_header",
        "//mino/shm/recovery:scanner",
        "@googletest//:gtest_main",
    ],
)

