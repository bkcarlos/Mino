    hdrs = ["channel_directory.h"],
    deps = [
        ":recovery_directory",
        ":superblock",
        "//mino/common:checked_arithmetic",
        "//mino/common:result",
        "//mino/common:status",
        "//mino/shm/channel:mpmc_ring",
        "//mino/shm/channel:ring_directory_abi",
    ],
)

cc_library(
    name = "recovery_directory",
