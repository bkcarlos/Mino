package(default_visibility = ["//visibility:public"])

cc_library(
    name = "security_domain",
    hdrs = ["security_domain.h"],
)

cc_library(
    name = "tls",
    srcs = ["tls.cc"],
    hdrs = ["tls.h"],
    deps = [
        ":security_domain",
        "//mino/common:ids",
        "//mino/common:result",
        "//mino/common:status",
        "@openssl//:ssl",
    ],
)

cc_library(
    name = "test_tls_credentials",
    testonly = True,
    srcs = ["test_tls_credentials.cc"],
    hdrs = ["test_tls_credentials.h"],
    deps = [
        ":tls",
        "//mino/common:result",
        "@openssl//:ssl",
    ],
)

cc_test(
    name = "tls_test",
    srcs = ["tls_test.cc"],
    deps = [
        ":test_tls_credentials",
        ":tls",
        "@googletest//:gtest_main",
        "@openssl//:ssl",
    ],
)

cc_library(
    name = "ipsec",
    srcs = [
        "ipsec.cc",
        "ipsec_policy.cc",
    ],
    hdrs = [
        "ipsec.h",
        "ipsec_policy.h",
    ],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":socket_ipsec",
        "//mino/common:result",
        "//mino/common:status",
    ],
)

cc_test(
    name = "ipsec_test",
    srcs = [
        "ipsec_policy_test.cc",
        "ipsec_test.cc",
        "socket_ipsec_test.cc",
    ],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":ipsec",
        ":socket_ipsec",
        "//mino/bridge:wire_frame",
        "//mino/transport:ipsec_transport",
        "//mino/transport:tcp_driver",
        "//mino/transport:udp_driver",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "socket_ipsec",
    srcs = ["socket_ipsec.cc"],
    hdrs = ["socket_ipsec.h"],
    deps = ["//mino/common:status"],
)
