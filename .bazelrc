# Mino Bazel configuration.
# See docs/Mino_详细设计文档.md section 3.4.

###############################################################################
# Common
###############################################################################

common --enable_bzlmod

# The local Java TLS stack cannot reach bcr.bazel.build reliably, so use its git
# mirror. CI uses --lockfile_mode=error and MODULE.bazel.lock verifies every
# registry file checksum; moving mirror content therefore cannot update builds.
common --registry=https://raw.githubusercontent.com/bazelbuild/bazel-central-registry/main

# C++20 for target and exec-platform C++ compilation. Code-generation tools
# such as minoc run in the exec configuration and must use the same language
# level as the compiler libraries they link.
build --cxxopt=-std=c++20
build --host_cxxopt=-std=c++20

# Warning policy: identical for CI and local builds.
build --cxxopt=-Wall
build --cxxopt=-Wextra
build --cxxopt=-Werror
build --host_cxxopt=-Wall
build --host_cxxopt=-Wextra
build --host_cxxopt=-Werror

# Build the pinned BCR OpenSSL source inside Bazel instead of downloading its
# optional pre-generated assembly side archive. This keeps TLS hermetic while
# avoiding a second GitHub release dependency in restricted build environments.
build --@openssl//:use-pregenerated=false

# GCC 12 emits a false positive from libstdc++'s std::variant destructor when a
# non-active std::string alternative is optimized under -O2. Keep this opt-in
# so Clang and newer GCC versions retain the full warning set.
build:gcc12 --cxxopt=-Wno-maybe-uninitialized
build:gcc12 --host_cxxopt=-Wno-maybe-uninitialized

# Opt-in downloaded LLVM/Clang toolchain. The :all pattern expands only to
# targets generated for the current host, so toolchain resolution works without
# forcing Linux, so `bazel query` and builds keep working on macOS. The
# toolchain is not globally registered; existing host compiler configs remain
# unchanged unless --config=hermetic is present.
build:hermetic --extra_toolchains=@mino_llvm//:all
# The downloaded toolchain defaults to C++17; Mino requires C++20 APIs such as
# std::atomic_ref, so override both target and exec compilation explicitly.
build:hermetic --cxxopt=-std=c++20
build:hermetic --host_cxxopt=-std=c++20
# Hermetic Clang uses lld directly for links; make the host libstdc++ runtime
# explicit because -stdlib=libstdc++ alone does not add it to every link action.
build:hermetic --linkopt=-lstdc++
build:hermetic --host_linkopt=-lstdc++
# GCC 12's libstdc++ marks legacy helpers used by the pinned GoogleTest as
# deprecated; Clang promotes that third-party warning under the global -Werror.
build:hermetic --cxxopt=-Wno-deprecated-declarations
build:hermetic --host_cxxopt=-Wno-deprecated-declarations

# Better diagnostics.
build --copt=-fno-omit-frame-pointer

# Do not fail builds on output paths differing between machines.
build --strip=never

# Comparison-only third-party sources are not maintained by Mino and currently
# emit GCC 15 warnings under the repository-wide -Werror policy. Keep warnings
# visible while limiting the exception to the explicit pipeline benchmark
# config; all Mino production sources retain warning-as-error.
build:pipeline_comparison --per_file_copt=external/.*@-Wno-error
build:pipeline_comparison --host_per_file_copt=external/.*@-Wno-error
# Fast DDS 3.4.x uses std::allocator::construct/destroy, removed in C++20.
# Compile only that external source archive as C++17; Mino and benchmark code
# remain C++20 and consume its public headers from the normal target config.
build:pipeline_comparison --per_file_copt=external/fastdds.*/.*@-std=c++17
build:pipeline_comparison --host_per_file_copt=external/fastdds.*/.*@-std=c++17
# Generated protobuf code and its direct benchmark consumer include third-party
# headers that warn differently under GCC and Clang. Keep those warnings visible
# without passing compiler-specific warning names or weakening other sources.
# Generated protobuf for the ZMQ business IPC comparison is pulled into
# default test builds. Keep warnings visible without failing -Werror.
build --per_file_copt=benchmarks/pipeline_comparison/autonomy_pipeline.pb.cc@-Wno-error
build --per_file_copt=external/protobuf.*@-Wno-error
build --host_per_file_copt=external/protobuf.*@-Wno-error
build --per_file_copt=external/abseil-cpp.*@-Wno-error
build --host_per_file_copt=external/abseil-cpp.*@-Wno-error

build:pipeline_comparison --per_file_copt=benchmarks/pipeline_comparison/autonomy_pipeline.pb.cc@-Wno-error
build:pipeline_comparison --per_file_copt=benchmarks/pipeline_comparison/protobuf_zmq_pipeline.cc@-Wno-error

###############################################################################
# debug (default-friendly)
###############################################################################

build:debug --compilation_mode=dbg
build:debug --copt=-g
build:debug --copt=-O0

###############################################################################
# release (reproducible)
###############################################################################

build:release --compilation_mode=opt
build:release --copt=-O2
build:release --copt=-DNDEBUG
# Reproducible builds: no debug info (removes embedded comp_dir paths),
# no stamps, and redact date/time macros. -g0 keeps this portable across
# GCC, Clang, and Apple Clang (-ffile-prefix-map with a bare path is not
# accepted by Apple Clang).
build:release --copt=-g0
build:release --copt=-Wno-builtin-macro-redefined
build:release --copt=-D__DATE__=\"redacted\"
build:release --copt=-D__TIME__=\"redacted\"
build:release --copt=-D__TIMESTAMP__=\"redacted\"
build:release --stamp=false

###############################################################################
# Sanitizers
#
# Sanitizer configs are mutually exclusive: ASAN/UBSAN/TSAN must never be
# combined in a single build or test process. Pick exactly one.
###############################################################################

build:asan --copt=-fsanitize=address
build:asan --copt=-fno-omit-frame-pointer
build:asan --copt=-g
build:asan --linkopt=-fsanitize=address
# NOTE: leak detection (detect_leaks) is left at the platform default -
# LSan is enabled by default on Linux but unsupported on macOS.

build:ubsan --copt=-fsanitize=undefined
build:ubsan --copt=-fno-omit-frame-pointer
build:ubsan --copt=-g
build:ubsan --linkopt=-fsanitize=undefined
build:ubsan --host_copt=-fsanitize=undefined
build:ubsan --host_copt=-fno-omit-frame-pointer
build:ubsan --host_copt=-g
build:ubsan --host_linkopt=-fsanitize=undefined
build:ubsan --test_env=UBSAN_OPTIONS=print_stacktrace=1:halt_on_error=1

# TSAN is incompatible with ASAN and UBSAN. Never pass --config=tsan together
# with --config=asan or --config=ubsan.
build:tsan --copt=-fsanitize=thread
build:tsan --copt=-fno-omit-frame-pointer
build:tsan --copt=-g
build:tsan --linkopt=-fsanitize=thread
# GCC diagnoses std::atomic_thread_fence as unsupported under TSAN even when
# the fence is used in a deliberately serialized offline upgrade path. Clang
# does not define the "tsan" warning group, so ignore unknown warning names
# before applying the GCC-specific demotion.
build:tsan --cxxopt=-Wno-unknown-warning-option
build:tsan --cxxopt=-Wno-error=tsan

# Clang coverage-guided fuzzing engine. Combine this with exactly one sanitizer
# configuration, for example: --config=asan --config=fuzz.
build:fuzz --copt=-fsanitize=fuzzer-no-link
build:fuzz --linkopt=-fsanitize=fuzzer
build:fuzz --linkopt=-fsanitize-link-c++-runtime

###############################################################################
# coverage
###############################################################################

build:coverage --collect_code_coverage
build:coverage --copt=--coverage
build:coverage --linkopt=--coverage
