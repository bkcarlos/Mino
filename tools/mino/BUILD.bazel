# mino: Mino CLI tool (D1-11 Inspector + recovery entry point).
package(default_visibility = ["//visibility:private"])

cc_library(
    name = "inspector",
    srcs = ["inspector.cc"],
    hdrs = ["inspector.h"],
    visibility = ["//visibility:private"],
    deps = [
        "//mino/common:result",
        "//mino/common:status",
        "//mino/shm/allocator:central_slab",
        "//mino/shm/allocator:slab_header",
        "//mino/shm/channel:index_slot",
        "//mino/shm/channel:mpmc_ring",
        "//mino/shm/region",
    ],
)

cc_library(
    name = "storage_commands",
    srcs = ["storage_commands.cc"],
    hdrs = ["storage_commands.h"],
    visibility = ["//visibility:private"],
    deps = [
        "//mino/common:result",
        "//mino/common:status",
        "//mino/storage:recording_manifest",
        "//mino/storage:replay_engine",
        "//mino/storage:segment_recovery",
        "//mino/schema/codegen:artifact_codec",
    ],
)

cc_test(
    name = "storage_commands_test",
    srcs = ["storage_commands_test.cc"],
    deps = [
        ":storage_commands",
        "//mino/common:status",
        "//mino/storage:recording_manifest",
        "//mino/storage:segment_format",
        "//mino/schema:compiler",
        "//mino/schema:layout",
        "//mino/schema/codegen:artifact_codec",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "inspector_test",
    srcs = ["inspector_test.cc"],
    deps = [
        ":inspector",
        "//mino/common:status",
        "//mino/platform:shared_memory",
        "//mino/shm/allocator:central_slab",
        "//mino/shm/region",
        "@googletest//:gtest_main",
    ],
)

cc_binary(
    name = "mino",
    srcs = ["main.cc"],
    visibility = ["//visibility:public"],
    deps = [
        ":inspector",
        ":storage_commands",
        "//mino/common:status",
        "//mino/shm/recovery:scanner",
    ],
)
