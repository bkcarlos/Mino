# mino: Mino CLI tool (D1-11 Inspector + recovery entry point).
package(default_visibility = ["//visibility:private"])

LINUX_ONLY = select({
    "@platforms//os:linux": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

exports_files(
    ["runtime.example.toml"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "inspector",
    srcs = ["inspector.cc"],
    hdrs = ["inspector.h"],
    visibility = ["//visibility:private"],
    deps = [
        "//mino/common:result",
        "//mino/common:status",
        "//mino/shm/allocator:central_slab",
        "//mino/shm/allocator:slab_header",
        "//mino/shm/channel:index_slot",
        "//mino/shm/channel:mpmc_ring",
        "//mino/shm/region",
    ],
)

cc_library(
    name = "storage_commands",
    srcs = ["storage_commands.cc"],
    hdrs = ["storage_commands.h"],
    visibility = ["//visibility:private"],
    deps = [
        "//mino/common:result",
        "//mino/common:status",
        "//mino/schema/codegen:artifact_codec",
        "//mino/storage:recording_manifest",
        "//mino/storage:replay_engine",
        "//mino/storage:segment_recovery",
    ],
)

cc_library(
    name = "runtime_services",
    srcs = ["runtime_services.cc"],
    hdrs = ["runtime_services.h"],
    copts = ["-Wno-deprecated-literal-operator"],
    visibility = ["//visibility:private"],
    deps = [
        ":storage_commands",
        "//mino/common:result",
        "//mino/common:status",
        "//mino/platform:process_identity",
        "//mino/registry",
        "//mino/runtime:bus",
        "//mino/runtime/deployment:local_bus",
        "//mino/schema:descriptor",
        "//mino/schema/codegen:artifact_codec",
        "//mino/storage:recorder",
        "//mino/storage:recorder_service",
        "//mino/storage:recorder_subscriber",
        "//mino/storage:recording_manifest",
        "//mino/storage:recording_policy",
        "//mino/storage:replay_engine",
        "//mino/storage:segment_format",
        "//mino/storage:segment_writer",
        "@tomlplusplus",
    ],
)

cc_test(
    name = "storage_commands_test",
    srcs = ["storage_commands_test.cc"],
    deps = [
        ":storage_commands",
        "//mino/common:status",
        "//mino/schema:compiler",
        "//mino/schema:layout",
        "//mino/schema/codegen:artifact_codec",
        "//mino/storage:recording_manifest",
        "//mino/storage:segment_format",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "runtime_services_test",
    srcs = ["runtime_services_test.cc"],
    deps = [
        ":runtime_services",
        ":storage_commands",
        "//mino/common:status",
        "//mino/registry",
        "//mino/runtime:bus",
        "//mino/schema:compiler",
        "//mino/schema:layout",
        "//mino/schema/codegen:artifact_codec",
        "//mino/storage:recorder",
        "//mino/storage:recorder_subscriber",
        "//mino/storage:recording_manifest",
        "//mino/storage:segment_recovery",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "inspector_test",
    srcs = ["inspector_test.cc"],
    target_compatible_with = LINUX_ONLY,
    deps = [
        ":inspector",
        "//mino/common:status",
        "//mino/platform:shared_memory",
        "//mino/shm/allocator:central_slab",
        "//mino/shm/region",
        "@googletest//:gtest_main",
    ],
)

cc_binary(
    name = "mino",
    srcs = ["main.cc"],
    visibility = ["//visibility:public"],
    deps = [
        ":inspector",
        ":runtime_services",
        ":storage_commands",
        "//mino/common:status",
        "//mino/shm/recovery:scanner",
    ],
)
