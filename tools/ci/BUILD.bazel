package(default_visibility = ["//visibility:private"])

py_library(
    name = "aarch64_validation_lib",
    srcs = ["aarch64_validation.py"],
    visibility = ["//visibility:public"],
)

py_binary(
    name = "aarch64_validation",
    srcs = ["aarch64_validation.py"],
    python_version = "PY3",
    visibility = ["//visibility:public"],
)

py_binary(
    name = "aarch64_cross_smoke",
    srcs = ["aarch64_cross_smoke.py"],
    python_version = "PY3",
    visibility = ["//visibility:public"],
)

genrule(
    name = "hermetic_clang_version",
    outs = ["hermetic-clang-version.txt"],
    cmd = "$(location @mino_llvm_llvm//:bin/clang) --version > $@",
    tags = ["manual"],
    tools = ["@mino_llvm_llvm//:bin/clang"],
)

cc_binary(
    name = "mino_two_host_probe",
    srcs = [
        "mino_two_host_probe.cc",
        "two_host_connection_group.cc",
        "two_host_connection_group.h",
    ],
    deps = [
        "//mino/bridge:bridge_connection_manager",
        "//mino/bridge:schema_negotiator",
        "//mino/common:result",
        "//mino/common:status",
        "//mino/schema:compiler",
        "//mino/schema:layout",
        "//mino/schema:registry",
        "//mino/schema/codegen:artifact_codec",
        "//mino/storage:schema_store",
        "//mino/transport:tcp_driver",
    ],
)

py_test(
    name = "two_host_protocol_test",
    srcs = [
        "finalize_two_host_manifest.py",
        "two_host_protocol.py",
    ],
    args = ["--self-test"],
    main = "finalize_two_host_manifest.py",
    python_version = "PY3",
)
